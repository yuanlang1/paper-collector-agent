FROM postgres@sha256:2d2b8998d31037bf721cfdf764d76ba74171b4fab3431b7f72c27c56ddbdf9e3

ARG PGVECTOR_VERSION=0.8.7
ARG ZHPARSER_REVISION=2e995c4df672563992b4d7a147b8fa2d0d4cda6c

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential postgresql-server-dev-17 \
       git curl ca-certificates bzip2 \
    && git clone --depth 1 --branch "v${PGVECTOR_VERSION}" \
       https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && make -C /tmp/pgvector \
       PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config \
    && make -C /tmp/pgvector \
       PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config install \
    && curl --fail --silent --show-error --location --retry 3 \
       https://www.xunsearch.com/scws/down/scws-1.2.3.tar.bz2 \
       | tar -xj -C /tmp \
    && cd /tmp/scws-1.2.3 \
    && ./configure --prefix=/usr/local \
    && make -j2 \
    && make install \
    && ldconfig \
    && git clone https://github.com/amutu/zhparser.git /tmp/zhparser \
    && git -C /tmp/zhparser checkout --detach "${ZHPARSER_REVISION}" \
    && make -C /tmp/zhparser \
       PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config \
    && make -C /tmp/zhparser \
       PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config install
