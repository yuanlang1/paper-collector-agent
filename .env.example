# Shared Redis infrastructure. Add the application's other required settings separately.
# Empty URL disables Redis. Configure independently of CELERY_BROKER_URL / CELERY_RESULT_BACKEND.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_MAX_CONNECTIONS=20
REDIS_KEY_PREFIX=paper-collector

# Shared venue records (24 hours). Keys: venue:{standardName}
VENUE_CACHE_TTL_SECONDS=86400

PAPER_ABSTRACT_TASK_TIMEOUT_SECONDS=180
PAPER_ABSTRACT_GROUP_TIMEOUT_SECONDS=900

# Fixed HTTP address reachable from FastAPI and Celery Worker.
PAPER_SERVICE_BASE_URL=http://paper-service:8080
