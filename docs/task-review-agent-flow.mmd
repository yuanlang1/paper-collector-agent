flowchart TD
    U["User / Agent request"] --> I["Initialize review: task_id, topic, options"]
    I --> P["Load and freeze task.paper_ids"]
    P --> G{"RAG coverage sufficient?"}
    G -->|"ready / allowed partial"| F["Generate framework once"]
    G -->|"not ready"| W["Blocked: wait for indexing"]
    F --> C["Generate claims per section"]
    C --> R["Filtered hybrid RAG\npaper + paper_content\npaper_ids snapshot only"]
    R --> E["Build evidence ledger"]
    E --> D["Render affected sections"]
    D --> A["Assemble review + references"]
    A --> Q["Reflect review\nevidence, citations, coverage, coherence"]
    Q -->|"approved"| O["Final review artifact"]
    Q -->|"citation or prose revision"| D
    Q -->|"evidence insufficient"| R
    Q -->|"claim must weaken or remove"| C
    Q -->|"max rounds reached"| X["Failed / partial with quality report"]
