flowchart LR
    U["User / Agent request"] --> I["Review request: task_id + topic"]
    I --> P["Load task.paper_ids via gRPC"]
    P --> G{"RAG indexes ready?"}
    G -->|"ready / partial"| F["Generate framework once"]
    G -->|"not ready"| W["Return indexed coverage or wait"]
    F --> C["Generate claims per section"]
    C --> R["Filtered hybrid retrieval\npaper + paper_content\npaper_ids only"]
    R --> E["Evidence ledger\nclaims + chunks + citations"]
    E --> D["Render sections from evidence"]
    D --> A["Assemble review + references"]
    A --> O["Review artifact"]
