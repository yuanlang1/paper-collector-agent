flowchart TD
    U["用户请求"] --> MG["主图: MainAgentState"]
    MG --> S["solve: 决策 direct / tool / subagent"]
    S -->|"direct"| FIN["final: 生成用户回复"]
    S -->|"tool"| TOOL["tool: 执行原子工具"]
    TOOL --> S

    S --> D["dispatch: 取出通用 active_tool_call"]
    D -->|"需要确认"| C["confirm: interrupt 后恢复"]
    C -->|"批准"| SUB
    C -->|"拒绝"| RESULT["统一 ToolMessage + ActionResult"]
    D -->|"kind = subagent"| SUB["subagent: 从注册表解析并执行"]
    SUB --> PSG["已注册的论文检索子图"]

    subgraph PAPER_SEARCH["论文检索子图: PaperSearchWorkflowState"]
        PSG --> INIT["initialize: 读取 active_tool_call.args"]
        INIT --> I["理解意图与构建检索标签"]
        I --> Q["生成多源查询计划"]
        Q --> A["arXiv -> DBLP -> Google Scholar"]
        A --> F["标准化、去重、过滤"]
        F --> RV["检索质量复盘"]
        RV -->|"需补充"| SP["补充检索规划"]
        SP --> A
        RV -->|"足够"| E["元数据与内容富化"]
        E --> CR["Crossref 富化"]
        CR --> V["期刊/会议解析"]
        V --> P["下载 PDF"]
        P --> AB["补全摘要"]
        AB --> RE["推荐排序"]
        RE --> T["创建论文检索任务"]
        T --> PE["持久化论文与任务关系"]
        PE --> CLEAN["删除本次任务下载的 PDF"]
        CLEAN --> TS["更新任务状态"]
        TS --> H["finalize_result: 写入统一工具结果"]
    end

    H --> RESULT
    RESULT --> D
